datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  category  String
  price     Float
  stock     Int
  image     String
  createdAt DateTime @default(now())
}

model Order {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  customerName String
  total        Float
  status       String   @default("Processing 🌸")
  createdAt    DateTime @default(now())
}

model Review {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  product  String   @default("Store Item")
  customer String
  rating   String
  comment  String
  date     String
}
